#!/bin/sh
# Git post-commit hook generated by create-agent-room
# Ambient session logging: records commit hash and touched files into .agent-room/sessions/.

if ! [ -d ".agent-room" ]; then
  exit 0
fi

if [ "${CAR_SKIP_HOOK:-0}" = "1" ] || [ "${CAR_SKIP_POST_COMMIT:-0}" = "1" ]; then
  exit 0
fi

if command -v create-agent-room >/dev/null 2>&1; then
  create-agent-room session . --record --status "In Progress" >/dev/null 2>&1 || true
elif [ -f "bin/cli.js" ]; then
  node "bin/cli.js" session . --record --status "In Progress" >/dev/null 2>&1 || true
fi
