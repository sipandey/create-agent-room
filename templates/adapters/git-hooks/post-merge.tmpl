#!/bin/sh
# Git post-merge hook generated by create-agent-room
# Automatically synchronizes AI agent tool rules after git pull/merge.

if ! [ -d ".agent-room" ]; then
  exit 0
fi

if [ "${CAR_SKIP_HOOK:-0}" = "1" ] || [ "${CAR_SKIP_POST_MERGE:-0}" = "1" ]; then
  exit 0
fi

if command -v create-agent-room >/dev/null 2>&1; then
  create-agent-room sync . --all >/dev/null 2>&1 || true
elif [ -f "bin/cli.js" ]; then
  node "bin/cli.js" sync . --all >/dev/null 2>&1 || true
fi
