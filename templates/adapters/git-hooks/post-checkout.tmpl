#!/bin/sh
# Git post-checkout hook generated by create-agent-room
# Automatically synchronizes AI agent tool rules when switching branches.

if ! [ -d ".agent-room" ]; then
  exit 0
fi

if [ "${CAR_SKIP_HOOK:-0}" = "1" ] || [ "${CAR_SKIP_POST_CHECKOUT:-0}" = "1" ]; then
  exit 0
fi

if command -v create-agent-room >/dev/null 2>&1; then
  create-agent-room hook post-checkout "$1" "$2" "$3" >/dev/null 2>&1 || true
elif [ -f "bin/cli.js" ]; then
  node "bin/cli.js" hook post-checkout "$1" "$2" "$3" >/dev/null 2>&1 || true
fi
