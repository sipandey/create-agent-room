#!/bin/sh
# Git pre-push hook generated by create-agent-room
# Pre-push local CI simulation to verify compliance before code reaches remotes.

if ! [ -d ".agent-room" ]; then
  exit 0
fi

if [ "${CAR_SKIP_HOOK:-0}" = "1" ] || [ "${CAR_SKIP_PRE_PUSH:-0}" = "1" ]; then
  exit 0
fi

BASE_REF="${CAR_BASE_REF:-origin/main}"

if command -v create-agent-room >/dev/null 2>&1; then
  create-agent-room ci --base "$BASE_REF"
  STATUS=$?
elif [ -f "bin/cli.js" ]; then
  node "bin/cli.js" ci --base "$BASE_REF"
  STATUS=$?
else
  STATUS=0
fi

if [ $STATUS -ne 0 ]; then
  echo "❌ create-agent-room: Pre-push compliance checks failed. Fix findings or bypass with git push --no-verify." >&2
  exit 1
fi
